{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/pay",
      "destination": "/pay/index.html"
    },
    {
      "source": "/pay/:path*",
      "destination": "/pay/:path*"
    },
    {
      "source": "/((?!api|pay|assets|favicon|apple-touch-icon|pwa-|sw\\.js|workbox-|manifest\\.webmanifest|registerSW\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
