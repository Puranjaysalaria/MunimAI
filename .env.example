# ==========================================
# Munim AI - Environment Configuration (.env)
# ==========================================

# 1. Frontend Supabase Configuration
# Used by the browser client to connect to Postgres, Auth, and Storage.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Speech-to-Text Provider Selection
# Options: 'browser' (default: Web Speech API with hi-IN & en-IN) or 'server' (pluggable server STT)
VITE_STT_PROVIDER=browser

# 3. Demo Mode (true/false)
# Set to 'true' to pre-load the 8 demo customers (incl. two Rameshes), 12 items, and sample transactions offline.
VITE_DEMO_MODE=true

# 4. App Defaults
VITE_DEFAULT_LANGUAGE=hi
VITE_CURRENCY_SYMBOL=₹

# 5. Payment Page Base URL (Optional: if unset, reminders include plain-text payment details only)
# VITE_PAYMENT_PAGE_BASE_URL=munim-ai.pages.dev

# ==========================================
# Supabase Edge Functions (Server-side Secrets)
# Never expose these in frontend code or repository!
# ==========================================
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GEMINI_API_KEY=your-gemini-api-key-for-voice-parsing
SARVAM_API_KEY=your-sarvam-ai-key-for-indic-stt
SMS_GATEWAY_API_KEY=your-sms-or-whatsapp-gateway-key
