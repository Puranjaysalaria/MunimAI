# ==============================================================================
# Munim AI - Environment Configuration (.env)
# ==============================================================================
#
# RULE FOR SECRETS:
# - PUBLIC VARIABLES (Browser): Must be prefixed with VITE_. Safe to expose in client bundle.
# - SECRETS (Server-side): NEVER prefix with VITE_. Used ONLY in Vercel Serverless Functions (/api/*)
#   or Supabase Edge Functions.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT VARIABLES (Safe in browser bundle)
# ------------------------------------------------------------------------------

# Supabase Project Connection (Public anon key is protected by Postgres Row Level Security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Speech-to-Text Provider: 'browser' (default Web Speech API) or 'server'
VITE_STT_PROVIDER=browser

# Offline Demo Mode: 'true' preloads 8 kirana customers, 12 inventory items, sample transactions
VITE_DEMO_MODE=true

# Application Defaults
VITE_DEFAULT_LANGUAGE=hi
VITE_CURRENCY_SYMBOL=₹

# Hosted Payment Page Domain (Optional: if unset, reminders include plain-text payment details only)
# Example: munim-ai.vercel.app or your custom domain
VITE_PAYMENT_PAGE_BASE_URL=munim-ai.vercel.app

# Optional: Enable mock fallback for bill photo scan in dev/demo when server function is not configured
VITE_ENABLE_MOCK_BILL_SCAN=true

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (Vercel Serverless Functions / Supabase Edge Functions)
# Strictly PRIVATE - NEVER use VITE_ prefix. Never committed to version control!
# ------------------------------------------------------------------------------

# Google Gemini API Key: Used strictly by serverless function /api/bill-scan for OCR
GEMINI_API_KEY=your-gemini-api-key

# Maximum daily bill scans allowed per kirana shop in /api/bill-scan (default: 20)
BILL_SCAN_DAILY_CAP=20

# Supabase Service Role Key: Bypasses RLS (Server-side admin operations only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Sarvam AI Indic STT Key (Edge functions only)
SARVAM_API_KEY=your-sarvam-api-key

# Optional: SMS / WhatsApp Cloud Gateway API Key
SMS_GATEWAY_API_KEY=your-sms-gateway-api-key
